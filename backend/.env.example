PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmrl_feeder
DB_USER=postgres
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
DRT_WORKER_INTERVAL_MS=1000
# Set to development only for local OTP retrieval. Production requires an OTP delivery integration.
OTP_DELIVERY_MODE=unconfigured

# Pilot station and approximate service-area geometry (EPSG:4326)
DRT_METRO_SERVICE_RADIUS_KM=16
DRT_STATION_GEOFENCE_RADIUS_M=300
DRT_SERVICE_ZONE_RADIUS_KM=3
THIRUMANGALAM_STATION_LAT=13.08528
THIRUMANGALAM_STATION_LON=80.20152
COLLECTOR_NAGAR_CENTER_LAT=13.08849
COLLECTOR_NAGAR_CENTER_LON=80.19097
# Golden Flats bus-stop / area reference (OpenStreetMap feature surfaced by Mapcarta).
GOLDEN_FLATS_CENTER_LAT=13.0883
GOLDEN_FLATS_CENTER_LON=80.17841
